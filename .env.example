NUXT_PUBLIC_API_BASE=http://localhost:8037/api

# Product analytics — PostHog (prd-analytics-posthog, ADR-024). Vazio = nada é carregado.
# Chave pública do projeto (phc_...). Só em produção.
NUXT_PUBLIC_POSTHOG_KEY=
# Default /ingest (proxy do nuxt.config). Sem proxy: https://eu.i.posthog.com
NUXT_PUBLIC_POSTHOG_HOST=
NUXT_PUBLIC_POSTHOG_UI_HOST=
