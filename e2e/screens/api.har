      "text": "{\"data\":[{\"id\":\"01a0f30c-4630-7240-a100-50fd933c2649\",\"deck_id\":\"01a0f30c-460b-716b-821e-2e8dc0f56173\",\"topic_id\":\"01a0f30c-45f8-7023-b9ac-b30d80035fd5\",\"topic_name\":\"Direito Constitucional\",\"source_note_id\":\"01a0f30c-4612-708b-9cd4-062e94e2b317\",\"tags\":[],\"type\":\"basic\",\"cloze_index\":null,\"cloze_group_id\":null,\"front\":\"Presidente da Câmara precisa ser brasileiro nato?\",\"front_audio_url\":null,\"back\":\"Sim, cargo privativo de brasileiro nato (art. 12, §3º).\",\"back_audio_url\":null,\"state\":\"review\",\"due\":\"2026-09-30T01:01:03.000000Z\",\"stability\":24.5,\"difficulty\":6.8,\"reps\":6,\"lapses\":2,\"learning_step_index\":null,\"is_learning\":false,\"origin\":{\"kind\":\"document\",\"note_id\":\"01a0f30c-4612-708b-9cd4-062e94e2b317\",\"title\":\"CF88 - Título II - Direitos e Garantias\",\"document_id\":\"01a0f30c-460e-722f-b1a2-00bcec4a4f1d\",\"document_name\":\"CF88 - Título II - Direitos e Garantias.pdf\",\"part\":{\"index\":1,\"total\":1},\"page\":null},\"created_at\":\"2026-09-30T16:01:03.000000Z\",\"updated_at\":\"2026-09-30T16:01:03.000000Z\"},{\"id\":\"01a0f30c-462f-73d4-9426-d8b518ff7f17\",\"deck_id\":\"01a0f30c-460b-716b-821e-2e8dc0f56173\",\"topic_id\":\"01a0f30c-45f8-7023-b9ac-b30d80035fd5\",\"topic_name\":\"Direito Constitucional\",\"source_note_id\":\"01a0f30c-4612-708b-9cd4-062e94e2b317\",\"tags\":[],\"type\":\"basic\",\"cloze_index\":null,\"cloze_group_id\":null,\"front\":\"Cite 3 direitos sociais do art. 6º.\",\"front_audio_url\":null,\"back\":\"Educação, saúde, alimentação (também trabalho, moradia, transporte, lazer...).\",\"back_audio_url\":null,\"state\":\"review\",\"due\":\"2026-09-30T02:01:03.000000Z\",\"stability\":8.5,\"difficulty\":6,\"reps\":5,\"lapses\":1,\"learning_step_index\":null,\"is_learning\":false,\"origin\":{\"kind\":\"document\",\"note_id\":\"01a0f30c-4612-708b-9cd4-062e94e2b317\",\"title\":\"CF88 - Título II - Direitos e Garantias\",\"document_id\":\"01a0f30c-460e-722f-b