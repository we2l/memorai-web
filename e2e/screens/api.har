      "mimeType": "application/json",
      "compression": 0,
      "text": "{\"data\":{\"id\":\"01a0f30c-45f8-7023-b9ac-b30d80035fd5\",\"name\":\"Direito Constitucional\",\"progress\":0.22,\"flashcards_count\":18,\"notes_count\":2,\"review_count\":4,\"weak_count\":3,\"due_count\":7,\"new_count\":7,\"streak\":0,\"flashcards_truncated\":false,\"flashcards\":[{\"id\":\"01a0f30c-4630-7240-a100-50fd933c2649\",\"deck_id\":\"01a0f30c-460b-716b-821e-2e8dc0f56173\",\"front\":\"Presidente da C\\u00e2mara precisa ser brasileiro nato?\",\"back\":\"Sim, cargo privativo de brasileiro nato (art. 12, \\u00a73\\u00ba).\",\"state\":\"review\",\"due\":\"2026-09-30T01:01:03.000000Z\",\"lapses\":2,\"source_note_id\":\"01a0f30c-4612-708b-9cd4-062e94e2b317\",\"tags\":[],\"topic_id\":\"01a0f30c-45f8-7023-b9ac-b30d80035fd5\",\"front_audio_url\":null,\"back_audio_url\":null},{\"id\":\"01a0f30c-462f-73d4-9426-d8b518ff7f17\",\"deck_id\":\"01a0f30c-460b-716b-821e-2e8dc0f56173\",\"front\":\"Cite 3 direitos sociais do art. 6\\u00ba.\",\"back\":\"Educa\\u00e7\\u00e3o, sa\\u00fade, alimenta\\u00e7\\u00e3o (tamb\\u00e9m trabalho, moradia, transporte, lazer...).\",\"state\":\"review\",\"due\":\"2026-09-30T02:01:03.000000Z\",\"lapses\":1,\"source_note_id\":\"01a0f30c-4612-708b-9cd4-062e94e2b317\",\"tags\":[],\"topic_id\":\"01a0f30c-45f8-7023-b9ac-b30d80035fd5\",\"front_audio_url\":null,\"back_audio_url\":null},{\"id\":\"01a0f30c-462d-72b1-83d7-a7fdef63b92d\",\"deck_id\":\"01a0f30c-460b-716b-821e-2e8dc0f56173\",\"front\":\"Quem pode propor a\\u00e7\\u00e3o popular?\",\"back\":\"Qualquer cidad\\u00e3o (eleitor).\",\"state\":\"review\",\"due\":\"2026-09-30T03:01:03.000000Z\",\"lapses\":0,\"source_note_id\":\"01a0f30c-4612-708b-9cd4-062e94e2b317\",\"tags\":[],\"topic_id\":\"01a0f30c-45f8-7023-b9ac-b30d80035fd5\",\"front_audio_url\":null,\"back_audio_url\":null},{\"id\":\"01a0f30c-4638-7169-8e17-1921feb2cf71\",\"deck_id\":\"01a0f30c-460b-716b-821e-2e8dc0f56173\",\"front\":\"Diferen\\u00e7a entre direito e garantia?\",\"back\":\"Direito \\u00e9 o bem protegido; garantia \\u00e9 o instrumento de prote\\u00e7\\u00e3o.\",\"state\":\"review\",\"due\":\"2026-09-30T14:01:03.000000Z\",\"lapses\":0,\"source_note_id\":\"01a0f30c-461b-7316-b298-4fb562d7a2e4\",\"tags\":[],\"topic_id\":\"01a0f30c-45f8-7023-b9ac-b30d80035fd5\",\"front_audio_url\":null,\"back_audio_url\":null},{\"id\":\"01a0f30c-462c-730b-90d8-fb1a604921a7\",\"deck_id\":\"01a0f30c-460b-716b-821e-2e8dc0f56173\",\"front\":\"Quando cabe mandado de injun\\u00e7\\u00e3o?\",\"back\":\"Quando a falta de norma regulamentadora inviabiliza direitos e liberdades constitucionais.\",\"state\":\"relearning\",\"due\":\"2026-09-30T15:31:03.000000Z\",\"lapses\":3,\"source_note_id\":\"01a0f30c-4612-708b-9cd4-062e94e2b317\",\"tags\":[],\"topic_id\":\"01a0f30c-45f8-7023-b9ac-b30d80035fd5\",\"front_audio_url\":null,\"back_audio_url\":null},{\"id\":\"01a0f30c-4629-70d4-b430-8778064d01e0\",\"deck_id\":\"01a0f30c-460b-716b-821e-2e8dc0f56173\",\"front\":\"Para que serve o habeas data?\",\"back\":\"Conhecer ou retificar informa\\u00e7\\u00f5es pessoais em bancos de dados p\\u00fablicos.\",\"state\":\"learning\",\"due\":\"2026-09-30T15:31:03.000000Z\",\"lapses\":0,\"source_note_id\":\"01a0f30c-4612-708b-9cd4-062e94e2b317\",\"tags\":[],\"topic_id\":\"01a0f30c-45f8-7023-b9ac-b30d80035fd5\",\"front_audio_url\":null,\"back_audio_url\":null},{\"id\":\"01a0f30c-4628-711f-9c11-86c9532f4a00\",\"deck_id\":\"01a0f30c-460b-716b-821e-2e8dc0f56173\",\"front\":\"Qual rem\\u00e9dio protege direito l\\u00edquido e certo n\\u00e3o amparado por HC ou HD?\",\"back\":\"Mandado de seguran\\u00e7a.\",\"state\":\"learning\",\"due\":\"2026-09-30T15:31:03.000000Z\",\"lapses\":0,\"source_note_id\":\"01a0f30c-4612-708b-9cd4-062e94e2b317\",\"tags\":[],\"topic_id\":\"01a0f30c-45f8-7023-b9ac-b30d80035fd5\",\"front_audio_url\":null,\"back_audio_url\":null},{\"id\":\"01a0f30c-4626-7281-8536-ed0625e3e5ab\",\"deck_id\":\"01a0f30c-460b-716b-821e-2e8dc0f56173\",\"front\":\"Qual rem\\u00e9dio protege a liberdade de locomo\\u00e7\\u00e3o?\",\"back\":\"Habeas corpus.\",\"state\":\"new\",\"due\":\"2026-09-30T16:01:03.000000Z\",\"lapses\":0,\"source_note_id\":\"01a0f30c-4612-708b-9cd4-062e94e2b317\",\"tags\":[],\"topic_id\":\"01a0f30c-45f8-7023-b9ac-b30d80035fd5\",\"front_audio_url\":null,\"back_audio_url\":null},{\"id\":\"01a0f30c-461f-71ad-a8ee-427ffdf03e66\",\"deck_id\":\"01a0f30c-460b-716b-821e-2e8dc0f56173\",\"front\":\"Quem \\u00e9 titular dos direitos do art. 5\\u00ba, caput?\",\"back\":\"Brasileiros e estrangeiros residentes no Pa\\u00eds (STF estende a n\\u00e3o residentes).\",\"state\":\"new\",\"due\":\"2026-09-30T16:01:03.000000Z\",\"lapses\":0,\"source_note_id\":\"01a0f30c-4612-708b-9cd4-062e94e2b317\",\"tags\":[],\"topic_id\":\"01a0f30c-45f8-7023-b9ac-b30d80035fd5\",\"front_audio_url\":null,\"back_audio_url\":null},{\"id\":\"01a0f30c-4621-716d-827f-6dc68f82168e\",\"deck_id\":\"01a0f30c-460b-716b-821e-2e8dc0f56173\",\"front\":\"O que diz o princ\\u00edpio da legalidade (art. 5\\u00ba, II)?\",\"back\":\"Ningu\\u00e9m \\u00e9 obrigado a fazer ou deixar de fazer algo sen\\u00e3o em virtude de lei.\",\"state\":\"new\",\"due\":\"2026-09-30T16:01:03.000000Z\",\"lapses\":0,\"source_note_id\":\"01a0f30c-4612-708b-9cd4-062e94e2b317\",\"tags\":[],\"topic_id\":\"01a0f30c-45f8-7023-b9ac-b30d80035fd5\",\"front_audio_url\":null,\"back_audio_url\":null},{\"id\":\"01a0f30c-4623-717e-8168-580e2ea92b87\",\"deck_id\":\"01a0f30c-460b-716b-821e-2e8dc0f56173\",\"front\":\"Quando se pode entrar na casa por determina\\u00e7\\u00e3o judicial?\",\"back\":\"Somente durante o dia.\",\"state\":\"new\",\"due\":\"2026-09-30T16:01:03.000000Z\",\"lapses\":0,\"source_note_id\":\"01a0f30c-4612-708b-9cd4-062e94e2b317\",\"tags\":[],\"topic_id\":\"01a0f30c-45f8-7023-b9ac-b30d80035fd5\",\"front_audio_url\":null,\"back_audio_url\":null},{\"id\":\"01a0f30c-4625-715c-bf2f-6d67c723b4db\",\"deck_id\":\"01a0f30c-460b-716b-821e-2e8dc0f56173\",\"front\":\"Em flagrante delito, a entrada no domic\\u00edlio pode ocorrer quando?\",\"back\":\"A qualquer hora, sem consentimento.\",\"state\":\"new\",\"due\":\"2026-09-30T16:01:03.000000Z\",\"lapses\":0,\"source_note_id\":\"01a0f30c-4612-708b-9cd4-062e94e2b317\",\"tags\":[],\"topic_id\":\"01a0f30c-45f8-7023-b9ac-b30d80035fd5\",\"front_audio_url\":null,\"back_audio_url\":null},{\"id\":\"01a0f30c-4639-71ae-8c6b-b0f9c7250e49\",\"deck_id\":\"01a0f30c-460b-716b-821e-2e8dc0f56173\",\"front\":\"Macete dos cargos privativos de nato?\",\"back\":\"MP3.COM: Ministro STF, Presidente\\/Vice, Presidentes C\\u00e2mara\\/Senado, Carreira diplom\\u00e1tica, Oficial FA, Ministro da Defesa.\",\"state\":\"new\",\"due\":\"2026-09-30T16:01:03.000000Z\",\"lapses\":0,\"source_note_id\":\"01a0f30c-461b-7316-b298-4fb562d7a2e4\",\"tags\":[],\"topic_id\":\"01a0f30c-45f8-7023-b9ac-b30d80035fd5\",\"front_audio_url\":null,\"back_audio_url\":null},{\"id\":\"01a0f30c-463b-7083-85b6-96ed01f2696d\",\"deck_id\":\"01a0f30c-460b-716b-821e-2e8dc0f56173\",\"front\":\"MS coletivo: partido precisa de qu\\u00ea?\",\"back\":\"Representa\\u00e7\\u00e3o no Congresso Nacional.\",\"state\":\"new\",\"due\":\"2026-09-30T16:01:03.000000Z\",\"lapses\":0,\"source_note_id\":\"01a0f30c-461b-7316-b298-4fb562d7a2e4\",\"tags\":[],\"topic_id\":\"01a0f30c-45f8-7023-b9ac-b30d80035fd5\",\"front_audio_url\":null,\"back_audio_url\":null},{\"id\":\"01a0f30c-4632-7221-8026-af96164c4e8f\",\"deck_id\":\"01a0f30c-460b-716b-821e-2e8dc0f56173\",\"front\":\"Ministro do STJ precisa ser brasileiro nato?\",\"back\":\"N\\u00e3o. Apenas Ministro do STF \\u00e9 privativo de nato.\",\"state\":\"review\",\"due\":\"2026-10-14T16:01:03.000000Z\",\"lapses\":0,\"source_note_id\":\"01a0f30c-4612-708b-9cd4-062e94e2b317\",\"tags\":[],\"topic_id\":\"01a0f30c-45f8-7023-b9ac-b30d80035fd5\",\"front_audio_url\":null,\"back_audio_url\":null},{\"id\":\"01a0f30c-4633-71a3-8196-d593a57f11aa\",\"deck_id\":\"01a0f30c-460b-716b-821e-2e8dc0f56173\",\"front\":\"Racismo \\u00e9 crime prescrit\\u00edvel?\",\"back\":\"N\\u00e3o. Inafian\\u00e7\\u00e1vel e imprescrit\\u00edvel (art. 5\\u00ba, XLII).\",\"state\":\"review\",\"due\":\"2026-10-15T16:01:03.000000Z\",\"lapses\":0,\"source_note_id\":\"01a0f30c-4612-708b-9cd4-062e94e2b317\",\"tags\":[],\"topic_id\":\"01a0f30c-45f8-7023-b9ac-b30d80035fd5\",\"front_audio_url\":null,\"back_audio_url\":null},{\"id\":\"01a0f30c-4635-73e8-a679-67b3fab46f5b\",\"deck_id\":\"01a0f30c-460b-716b-821e-2e8dc0f56173\",\"front\":\"O anonimato \\u00e9 permitido na manifesta\\u00e7\\u00e3o do pensamento?\",\"back\":\"N\\u00e3o, \\u00e9 vedado (art. 5\\u00ba, IV).\",\"state\":\"review\",\"due\":\"2026-10-16T16:01:03.000000Z\",\"lapses\":0,\"source_note_id\":\"01a0f30c-4612-708b-9cd4-062e94e2b317\",\"tags\":[],\"topic_id\":\"01a0f30c-45f8-7023-b9ac-b30d80035fd5\",\"front_audio_url\":null,\"back_audio_url\":null},{\"id\":\"01a0f30c-4636-7079-974d-46c4057ee69a\",\"deck_id\":\"01a0f30c-460b-716b-821e-2e8dc0f56173\",\"front\":\"Ministro de Estado da Defesa deve ser brasileiro nato?\",\"back\":\"Sim.\",\"state\":\"review\",\"due\":\"2026-10-17T16:01:03.000000Z\",\"lapses\":0,\"source_note_id\":\"01a0f30c-4612-708b-9cd4-062e94e2b317\",\"tags\":[],\"topic_id\":\"01a0f30c-45f8-7023-b9ac-b30d80035fd5\",\"front_audio_url\":null,\"back_audio_url\":null}],\"notes\":[{\"id\":\"01a0f30c-461b-7316-b298-4fb562d7a2e4\",\"title\":\"Minhas anota\\u00e7\\u00f5es\"},{\"id\":\"01a0f30c-4612-708b-9cd4-062e94e2b317\",\"title\":\"CF88 - T\\u00edtulo II - Direitos e Garantias\"}],\"goal\":null,\"evolution\":{\"mastered\":8,\"recovered\":2,\"total\":18}}}"
