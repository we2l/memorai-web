\"difficulty\":0,\"reps\":0,\"lapses\":0,\"learning_step_index\":null,\"is_learning\":false,\"origin\":{\"kind\":\"document\",\"note_id\":\"01a0f30c-4612-708b-9cd4-062e94e2b317\",\"title\":\"CF88 - Título II - Direitos e Garantias\",\"document_id\":\"01a0f30c-460e-722f-b1a2-00bcec4a4f1d\",\"document_name\":\"CF88 - Título II - Direitos e Garantias.pdf\",\"part\":{\"index\":1,\"total\":1},\"page\":null},\"created_at\":\"2026-09-30T16:01:03.000000Z\",\"updated_at\":\"2026-09-30T16:01:03.000000Z\"},{\"id\":\"01a0f30c-4621-716d-827f-6dc68f82168e\",\"deck_id\":\"01a0f30c-460b-716b-821e-2e8dc0f56173\",\"topic_id\":\"01a0f30c-45f8-7023-b9ac-b30d80035fd5\",\"topic_name\":\"Direito Constitucional\",\"source_note_id\":\"01a0f30c-4612-708b-9cd4-062e94e2b317\",\"tags\":[],\"type\":\"basic\",\"cloze_index\":null,\"cloze_group_id\":null,\"front\":\"O que diz o princípio da legalidade (art. 5º, II)?\",\"front_audio_url\":null,\"back\":\"Ninguém é obrigado a fazer ou deixar de fazer algo senão em virtude de lei.\",\"back_audio_url\":null,\"state\":\"new\",\"due\":\"2026-09-30T16:01:03.000000Z\",\"stability\":0,\"difficulty\":0,\"reps\":0,\"lapses\":0,\"learning_step_index\":null,\"is_learning\":false,\"origin\":{\"kind\":\"document\",\"note_id\":\"01a0f30c-4612-708b-9cd4-062e94e2b317\",\"title\":\"CF88 - Título II - Direitos e Garantias\",\"document_id\":\"01a0f30c-460e-722f-b1a2-00bcec4a4f1d\",\"document_name\":\"CF88 - Título II - Direitos e Garantias.pdf\",\"part\":{\"index\":1,\"total\":1},\"page\":null},\"created_at\":\"2026-09-30T16:01:03.000000Z\",\"updated_at\":\"2026-09-30T16:01:03.000000Z\"},{\"id\":\"01a0f30c-4623-717e-8168-580e2ea92b87\",\"deck_id\":\"01a0f30c-460b-716b-821e-2e8dc0f56173\",\"topic_id\":\"01a0f30c-45f8-7023-b9ac-b30d80035fd5\",\"topic_name\":\"Direito Constitucional\",\"source_note_id\":\"01a0f30c-4612-708b-9cd4-062e94e2b317\",\"tags\":[],\"type\":\"basic\",\"cloze_index\":null,\"cloze_group_id\":null,\"front\":\"Quando se pode entrar na casa por determinação judicial?\",\"front_audio_url\":null,\"back\":\"Somente durante o dia.\",\"back_audio_url\":null,\"state\":\"new\",\"due\":\"2026-09-30T16:01:03.000000Z\",\"stability\":0,\"difficulty\":0,\"reps\":0,\"lapses\":0,\"learning_step_index\":null,\"is_learning\":false,\"origin\":{\"kind\":\"document\",\"note_id\":\"01a0f30c-4612-708b-9cd4-062e94e2b317\",\"title\":\"CF88 - Título II - Direitos e Garantias\",\"document_id\":\"01a0f30c-460e-722f-b1a2-00bcec4a4f1d\",\"document_name\":\"CF88 - Título II - Direitos e Garantias.pdf\",\"part\":{\"index\":1,\"total\":1},\"page\":null},\"created_at\":\"2026-09-30T16:01:03.000000Z\",\"updated_at\":\"2026-09-30T16:01:03.000000Z\"},{\"id\":\"01a0f30c-4625-715c-bf2f-6d67c723b4db\",\"deck_id\":\"01a0f30c-460b-716b-821e-2e8dc0f56173\",\"topic_id\":\"01a0f30c-45f8-7023-b9ac-b30d80035fd5\",\"topic_name\":\"Direito Constitucional\",\"source_note_id\":\"01a0f30c-4612-708b-9cd4-062e94e2b317\",\"tags\":[],\"type\":\"basic\",\"cloze_index\":null,\"cloze_group_id\":null,\"front\":\"Em flagrante delito, a entrada no domicílio pode ocorrer quando?\",\"front_audio_url\":null,\"back\":\"A qualquer hora, sem consentimento.\",\"back_audio_url\":null,\"state\":\"new\",\"due\":\"2026-09-30T16:01:03.000000Z\",\"stability\":0,\"difficulty\":0,\"reps\":0,\"lapses\":0,\"learning_step_index\":null,\"is_learning\":false,\"origin\":{\"kind\":\"document\",\"note_id\":\"01a0f30c-4612-708b-9cd4-062e94e2b317\",\"title\":\"CF88 - Título II - Direitos e Garantias\",\"document_id\":\"01a0f30c-460e-722f-b1a2-00bcec4a4f1d\",\"document_name\":\"CF88 - Título II - Direitos e Garantias.pdf\",\"part\":{\"index\":1,\"total\":1},\"page\":null},\"created_at\":\"2026-09-30T16:01:03.000000Z\",\"updated_at\":\"2026-09-30T16:01:03.000000Z\"},{\"id\":\"01a0f30c-4626-7281-8536-ed0625e3e5ab\",\"deck_id\":\"01a0f30c-460b-716b-821e-2e8dc0f56173\",\"topic_id\":\"01a0f30c-45f8-7023-b9ac-b30d80035fd5\",\"topic_name\":\"Direito Constitucional\",\"source_note_id\":\"01a0f30c-4612-708b-9cd4-062e94e2b317\",\"tags\":[],\"type\":\"basic\",\"cloze_index\":null,\"cloze_group_id\":null,\"front\":\"Qual remédio protege a liberdade de locomoção?\",\"front_audio_url\":null,\"back\":\"Habeas corpus.\",\"back_audio_url\":null,\"state\":\"new\",\"due\":\"2026-09-30T16:01:03.000000Z\",\"stability\":0,\"difficulty\":0,\"reps\":0,\"lapses\":0,\"learning_step_index\":null,\"is_learning\":false,\"origin\":{\"kind\":\"document\",\"note_id\":\"01a0f30c-4612-708b-9cd4-062e94e2b317\",\"title\":\"CF88 - Título II - Direitos e Garantias\",\"document_id\":\"01a0f30c-460e-722f-b1a2-00bcec4a4f1d\",\"document_name\":\"CF88 - Título II - Direitos e Garantias.pdf\",\"part\":{\"index\":1,\"total\":1},\"page\":null},\"created_at\":\"2026-09-30T16:01:03.000000Z\",\"updated_at\":\"2026-09-30T16:01:03.000000Z\"},{\"id\":\"01a0f30c-4639-71ae-8c6b-b0f9c7250e49\",\"deck_id\":\"01a0f30c-460b-716b-821e-2e8dc0f56173\",\"topic_id\":\"01a0f30c-45f8-7023-b9ac-b30d80035fd5\",\"topic_name\":\"Direito Constitucional\",\"source_note_id\":\"01a0f30c-461b-7316-b298-4fb562d7a2e4\",\"tags\":[],\"type\":\"basic\",\"cloze_index\":null,\"cloze_group_id\":null,\"front\":\"Macete dos cargos privativos de nato?\",\"front_audio_url\":null,\"back\":\"MP3.COM: Ministro STF, Presidente/Vice, Presidentes Câmara/Senado, Carreira diplomática, Oficial FA, Ministro da Defesa.\",\"back_audio_url\":null,\"state\":\"new\",\"due\":\"2026-09-30T16:01:03.000000Z\",\"stability\":0,\"difficulty\":0,\"reps\":0,\"lapses\":0,\"learning_step_index\":null,\"is_learning\":false,\"origin\":{\"kind\":\"note\",\"note_id\":\"01a0f30c-461b-7316-b298-4fb562d7a2e4\",\"title\":\"Minhas anotações\",\"topic_id\":\"01a0f30c-45f8-7023-b9ac-b30d80035fd5\"},\"created_at\":\"2026-09-30T16:01:03.000000Z\",\"updated_at\":\"2026-09-30T16:01:03.000000Z\"},{\"id\":\"01a0f30c-463b-7083-85b6-96ed01f2696d\",\"deck_id\":\"01a0f30c-460b-716b-821e-2e8dc0f56173\",\"topic_id\":\"01a0f30c-45f8-7023-b9ac-b30d80035fd5\",\"topic_name\":\"Direito Constitucional\",\"source_note_id\":\"01a0f30c-461b-7316-b298-4fb562d7a2e4\",\"tags\":[],\"type\":\"basic\",\"cloze_index\":null,\"cloze_group_id\":null,\"front\":\"MS coletivo: partido precisa de quê?\",\"front_audio_url\":null,\"back\":\"Representação no Congresso Nacional.\",\"back_audio_url\":null,\"state\":\"new\",\"due\":\"2026-09-30T16:01:03.000000Z\",\"stability\":0,\"difficulty\":0,\"reps\":0,\"lapses\":0,\"learning_step_index\":null,\"is_learning\":false,\"origin\":{\"kind\":\"note\",\"note_id\":\"01a0f30c-461b-7316-b298-4fb562d7a2e4\",\"title\":\"Minhas anotações\",\"topic_id\":\"01a0f30c-45f8-7023-b9ac-b30d80035fd5\"},\"created_at\":\"2026-09-30T16:01:03.000000Z\",\"updated_at\":\"2026-09-30T16:01:03.000000Z\"},{\"id\":\"01a0f30c-4640-7308-9ed2-9e88dc061564\",\"deck_id\":\"01a0f30c-460b-716b-821e-2e8dc0f56173\",\"topic_id\":\"01a0f30c-45fb-724d-97fc-96be5ad514d9\",\"topic_name\":\"Direitos Fundamentais (Art. 5º)\",\"source_note_id\":\"01a0f30c-461c-7339-98c2-a2371c04f84a\",\"tags\":[],\"type\":\"basic\",\"cloze_index\":null,\"cloze_group_id\":null,\"front\":\"Inciso IV trata de?\",\"front_audio_url\":null,\"back\":\"Livre manifestação do pensamento, vedado o anonimato.\",\"back_audio_url\":null,\"state\":\"new\",\"due\":\"2026-09-30T16:01:03.000000Z\",\"stability\":0,\"difficulty\":0,\"reps\":0,\"lapses\":0,\"learning_step_index\":null,\"is_learning\":false,\"origin\":{\"kind\":\"note\",\"note_id\":\"01a0f30c-461c-7339-98c2-a2371c04f84a\",\"title\":\"Incisos mais cobrados do art. 5º\",\"topic_id\":\"01a0f30c-45fb-724d-97fc-96be5ad514d9\"},\"created_at\":\"2026-09-30T16:01:03.000000Z\",\"updated_at\":\"2026-09-30T16:01:03.000000Z\"},{\"id\":\"01a0f30c-4642-7307-ae31-a3baf97d0a24\",\"deck_id\":\"01a0f30c-460b-716b-821e-2e8dc0f56173\",\"topic_id\":\"01a0f30c-45fb-724d-97fc-96be5ad514d9\",\"topic_name\":\"Direitos Fundamentais (Art. 5º)\",\"source_note_id\":\"01a0f30c-461c-7339-98c2-a2371c04f84a\",\"tags\":[],\"type\":\"basic\",\"cloze_index\":null,\"cloze_group_id\":null,\"front\":\"Inciso X trata de?\",\"front_audio_url\":null,\"back\":\"Intimidade, vida privada, honra e imagem.\",\"back_audio_url\":null,\"state\":\"new\",\"due\":\"2026-09-30T16:01:03.000000Z\",\"stability\":0,\"difficulty\":0,\"reps\":0,\"lapses\":0,\"learning_step_index\":null,\"is_learning\":false,\"origin\":{\"kind\":\"note\",\"note_id\":\"01a0f30c-461c-7339-98c2-a2371c04f84a\",\"title\":\"Incisos mais cobrados do art. 5º\",\"topic_id\":\"01a0f30c-45fb-724d-97fc-96be5ad514d9\"},\"created_at\":\"2026-09-30T16:01:03.000000Z\",\"updated_at\":\"2026-09-30T16:01:03.000000Z\"},{\"id\":\"01a0f30c-4646-70ac-a503-43225ca7932e\",\"deck_id\":\"01a0f30c-460b-716b-821e-2e8dc0f56173\",\"topic_id\":\"01a0f30c-45fe-7201-8156-04c8df2038bf\",\"topic_name\":\"Remédios Constitucionais\",\"source_note_id\":null,\"tags\":[],\"type\":\"basic\",\"cloze_index\":null,\"cloze_group_id\":null,\"front\":\"HC pode ser impetrado por pessoa jurídica?\",\"front_audio_url\":null,\"back\":\"Sim, em favor de pessoa física.\",\"back_audio_url\":null,\"state\":\"new\",\"due\":\"2026-09-30T16:01:03.000000Z\",\"stability\":0,\"difficulty\":0,\"reps\":0,\"lapses\":0,\"learning_step_index\":null,\"is_learning\":false,\"origin\":null,\"created_at\":\"2026-09-30T16:01:03.000000Z\",\"updated_at\":\"2026-09-30T16:01:03.000000Z\"},{\"id\":\"01a0f30c-464a-7329-b142-c242290db7ca\",\"deck_id\":\"01a0f30c-460b-716b-821e-2e8dc0f56173\",\"topic_id\":\"01a0f30c-45fe-7201-8156-04c8df2038bf\",\"topic_name\":\"Remédios Constitucionais\",\"source_note_id\":null,\"tags\":[],\"type\":\"basic\",\"cloze_index\":null,\"cloze_group_id\":null,\"front\":\"HC é gratuito?\",\"front_audio_url\":null,\"back\":\"Sim (art. 5º, LXXVII).\",\"back_audio_url\":null,\"state\":\"new\",\"due\":\"2026-09-30T16:01:03.000000Z\",\"stability\":0,\"difficulty\":0,\"reps\":0,\"lapses\":0,\"learning_step_index\":null,\"is_learning\":false,\"origin\":null,\"created_at\":\"2026-09-30T16:01:03.000000Z\",\"updated_at\":\"2026-09-30T16:01:03.000000Z\"},{\"id\":\"01a0f30c-4632-7221-8026-af96164c4e8f\",\"deck_id\":\"01a0f30c-460b-716b-821e-2e8dc0f56173\",\"topic_id\":\"01a0f30c-45f8-7023-b9ac-b30d80035fd5\",\"topic_name\":\"Direito Constitucional\",\"source_note_id\":\"01a0f30c-4612-708b-9cd4-062e94e2b317\",\"tags\":[],\"type\":\"basic\",\"cloze_index\":null,\"cloze_group_id\":null,\"front\":\"Ministro do STJ precisa ser brasileiro nato?\",\"front_audio_url\":null,\"back\":\"Não. Apenas Ministro do STF é privativo de nato.\",\"back_audio_url\":null,\"state\":\"review\",\"due\":\"2026-10-14T16:01:03.000000Z\",\"stability\":21.5,\"difficulty\":5.2,\"reps\":4,\"lapses\":0,\"learning_step_index\":null,\"is_learning\":false,\"origin\":{\"kind\":\"document\",\"note_id\":\"01a0f30c-4612-708b-9cd4-062e94e2b317\",\"title\":\"CF88 - Título II - Direitos e Garantias\",\"document_id\":\"01a0f30c-460e-722f-b1a2-00bcec4a4f1d\",\"document_name\":\"CF88 - Título II - Direitos e Garantias.pdf\",\"part\":{\"index\":1,\"total\":1},\"page\":null},\"created_at\":\"2026-09-30T16:01:03.000000Z\",\"updated_at\":\"2026-09-30T16:01:03.000000Z\"},{\"id\":\"01a0f30c-4633-71a3-8196-d593a57f11aa\",\"deck_id\":\"01a0f30c-460b-716b-821e-2e8dc0f56173\",\"topic_id\":\"01a0f30c-45f8-7023-b9ac-b30d80035fd5\",\"topic_name\":\"Direito Constitucional\",\"source_note_id\":\"01a0f30c-4612-708b-9cd4-062e94e2b317\",\"tags\":[],\"type\":\"basic\",\"cloze_index\":null,\"cloze_group_id\":null,\"front\":\"Racismo é crime prescritível?\",\"front_audio_url\":null,\"back\":\"Não. Inafiançável e imprescritível (art. 5º, XLII).\",\"back_audio_url\":null,\"state\":\"review\",\"due\":\"2026-10-15T16:01:03.000000Z\",\"stability\":4.5,\"difficulty\":5.2,\"reps\":3,\"lapses\":0,\"learning_step_index\":null,\"is_learning\":false,\"origin\":{\"kind\":\"document\",\"note_id\":\"01a0f30c-4612-708b-9cd4-062e94e2b317\",\"title\":\"CF88 - Título II - Direitos e Garantias\",\"document_id\":\"01a0f30c-460e-722f-b1a2-00bcec4a4f1d\",\"document_name\":\"CF88 - Título II - Direitos e Garantias.pdf\",\"part\":{\"index\":1,\"total\":1},\"page\":null},\"created_at\":\"2026-09-30T16:01:03.000000Z\",\"updated_at\":\"2026-09-30T16:01:03.000000Z\"},{\"id\":\"01a0f30c-4635-73e8-a679-67b3fab46f5b\",\"deck_id\":\"01a0f30c-460b-716b-821e-2e8dc0f56173\",\"topic_id\":\"01a0f30c-45f8-7023-b9ac-b30d80035fd5\",\"topic_name\":\"Direito Constitucional\",\"source_note_id\":\"01a0f30c-4612-708b-9cd4-062e94e2b317\",\"tags\":[],\"type\":\"basic\",\"cloze_index\":null,\"cloze_group_id\":null,\"front\":\"O anonimato é permitido na manifestação do pensamento?\",\"front_audio_url\":null,\"back\":\"Não, é vedado (art. 5º, IV).\",\"back_audio_url\":null,\"state\":\"review\",\"due\":\"2026-10-16T16:01:03.000000Z\",\"stability\":20.5,\"difficulty\":5.2,\"reps\":4,\"lapses\":0,\"learning_step_index\":null,\"is_learning\":false,\"origin\":{\"kind\":\"document\",\"note_id\":\"01a0f30c-4612-708b-9cd4-062e94e2b317\",\"title\":\"CF88 - Título II - Direitos e Garantias\",\"document_id\":\"01a0f30c-460e-722f-b1a2-00bcec4a4f1d\",\"document_name\":\"CF88 - Título II - Direitos e Garantias.pdf\",\"part\":{\"index\":1,\"total\":1},\"page\":null},\"created_at\":\"2026-09-30T16:01:03.000000Z\",\"updated_at\":\"2026-09-30T16:01:03.000000Z\"},{\"id\":\"01a0f30c-4636-7079-974d-46c4057ee69a\",\"deck_id\":\"01a0f30c-460b-716b-821e-2e8dc0f56173\",\"topic_id\":\"01a0f30c-45f8-7023-b9ac-b30d80035fd5\",\"topic_name\":\"Direito Constitucional\",\"source_note_id\":\"01a0f30c-4612-708b-9cd4-062e94e2b317\",\"tags\":[],\"type\":\"basic\",\"cloze_index\":null,\"cloze_group_id\":null,\"front\":\"Ministro de Estado da Defesa deve ser brasileiro nato?\",\"front_audio_url\":null,\"back\":\"Sim.\",\"back_audio_url\":null,\"state\":\"review\",\"due\":\"2026-10-17T16:01:03.000000Z\",\"stability\":17.5,\"difficulty\":5.2,\"reps\":5,\"lapses\":0,\"learning_step_index\":null,\"is_learning\":false,\"origin\":{\"kind\":\"document\",\"note_id\":\"01a0f30c-4612-708b-9cd4-062e94e2b317\",\"title\":\"CF88 - Títu